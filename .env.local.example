# Copia este ficheiro para ".env.local" (na raiz do projeto) e preenche
# com os valores reais do teu projeto Supabase.
#
# Onde encontrar estes valores:
# Supabase Dashboard -> Project Settings (ícone de engrenagem) -> API
#
# O ficheiro ".env.local" NUNCA deve ser enviado para o GitHub
# (já está protegido no .gitignore).

NEXT_PUBLIC_SUPABASE_URL=cola_aqui_o_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=cola_aqui_a_anon_public_key

# --- Envio de email do formulário de Contactos ---
# Sem estas duas variáveis, o formulário em /contactos continua a
# funcionar na mesma (as mensagens ficam sempre guardadas e visíveis em
# /admin/contactos) — só não chega o email de aviso.
#
# 1. Cria uma conta grátis em https://resend.com
# 2. Dashboard -> API Keys -> Create API Key -> copia o valor para baixo
# 3. CONTACT_EMAIL_TO é o teu email, onde queres receber o aviso
RESEND_API_KEY=cola_aqui_a_tua_api_key_do_resend
CONTACT_EMAIL_TO=o-teu-email@exemplo.com
